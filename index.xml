<?xml version="1.0" encoding="utf-8" standalone="yes"?><rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom"><channel><title>AI 进展追踪</title><link>https://martinsky999.github.io/</link><description>Recent content on AI 进展追踪</description><generator>Hugo</generator><language>zh-CN</language><lastBuildDate>Wed, 01 Apr 2026 00:00:00 +0000</lastBuildDate><atom:link href="https://martinsky999.github.io/index.xml" rel="self" type="application/rss+xml"/><item><title>公告</title><link>https://martinsky999.github.io/announcements/</link><pubDate>Wed, 01 Apr 2026 00:00:00 +0000</pubDate><guid>https://martinsky999.github.io/announcements/</guid><description>&lt;ul>
